# Copy this file to backend/.env (never commit backend/.env).
#
# Development PostgreSQL started by `docker compose up -d` at the repository
# root (pgvector/pgvector:pg16, credentials in docker-compose.yml are
# development-only). The URL must use the asyncpg driver form.
DATABASE_URL=postgresql+asyncpg://cycloai:<your-local-password>@localhost:5432/cycloai_dev