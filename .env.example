# Copy this file to `.env` (at the repository root, next to docker-compose.yml)
# and fill in the values. `.env` is ignored by git and must NEVER be committed.
#
# Generate a random password with:  openssl rand -base64 24

# Development PostgreSQL password used by docker-compose.yml (required).
# PLACEHOLDER ONLY - replace with your own random value:
POSTGRES_PASSWORD=<generate-one-with-openssl-rand-base64-24>
